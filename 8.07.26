# for i in range(5,0,-1):
#     s = ""
#     for j in range(i):
#         s += "*"
#     print(s)


n = 5
for i in range(n):
    for j in range((2 - i + 1)):
        print(" ", end="")
    for j in range(2 * i + 1):
        print("#", end="")
    print()

